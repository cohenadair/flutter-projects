{
    "folders": [
        {
            "path": "."
        },
        {
            "path": "activity-log"
        },
        {
            "path": "adair-flutter-lib"
        },
        {
            "path": "adair-flutter-lib-tester"
        },
        {
            "path": "anglers-log"
        },
        {
            "path": "pro-iq"
        }
    ],
    "settings": {
        "git.repositoryScanIgnoredFolders": [
            ".claude/worktrees"
        ],
        "dart.analysisExcludedFolders": [
            "/Users/cohen/Documents/flutter-projects/activity-log/mobile/build",
            "/Users/cohen/Documents/flutter-projects/anglers-log/mobile/build",
            "/Users/cohen/Documents/flutter-projects/pro-iq/build",
            "/Users/cohen/Documents/flutter-projects/adair-flutter-lib/build",
            "/Users/cohen/Documents/flutter-projects/adair-flutter-lib-tester/build"
        ],
        "editor.fontSize": 14,
        "debug.console.fontSize": 14,
        "terminal.integrated.fontSize": 14,
        "[typescript]": {
            "editor.tabSize": 2,
            "editor.insertSpaces": true,
            "editor.detectIndentation": false
        },
        "[proto]": {
            "editor.formatOnSave": false
        }
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "pro-iq (prod)",
                "cwd": "${workspaceFolder:pro-iq}",
                "request": "launch",
                "type": "dart",
                "program": "lib/main.dart",
                "args": [
                    "--flavor=proIq",
                    "--dart-define-from-file=dart_defines/pro-iq.json"
                ]
            },
            {
                "name": "pro-iq (emulator)",
                "cwd": "${workspaceFolder:pro-iq}",
                "request": "launch",
                "type": "dart",
                "program": "lib/main.dart",
                "args": [
                    "--flavor=proIq",
                    "--dart-define-from-file=dart_defines/pro-iq.json",
                    "--dart-define=USE_EMULATOR=true"
                ]
            },
            {
                "name": "hill-method-coaching (emulator)",
                "cwd": "${workspaceFolder:pro-iq}",
                "request": "launch",
                "type": "dart",
                "program": "lib/main.dart",
                "args": [
                    "--flavor=hillMethodCoaching",
                    "--dart-define-from-file=dart_defines/hill-method-coaching.json",
                    "--dart-define=USE_EMULATOR=true"
                ]
            },
            {
                "name": "activity-log",
                "cwd": "${workspaceFolder:activity-log}/mobile",
                "request": "launch",
                "type": "dart"
            },
            {
                "name": "anglers-log",
                "cwd": "${workspaceFolder:anglers-log}/mobile",
                "request": "launch",
                "type": "dart"
            }
        ]
    }
}