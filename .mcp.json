{
  "mcpServers": {
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@latest",
        "mcp",
        "--tools",
        "firebase_get_environment,firebase_update_environment,firebase_list_projects,firebase_get_project,firebase_list_apps,crashlytics_get_issue,crashlytics_list_events,crashlytics_batch_get_events,crashlytics_get_report,crashlytics_list_notes,crashlytics_create_note,crashlytics_update_issue,crashlytics_delete_note"
      ]
    }
  }
}
